# FlytBase Cockpit UI frontend address (running via Docker on host)
COCKPIT_URL=http://localhost:4010

# FlytBase Backend & Control API base URL (simulator, drone commands, faults)
CONTROL_API_URL=http://localhost:4000/api

# Midscene model config (Gemini via OpenAI-compatible endpoint)
MIDSCENE_MODEL_API_KEY=            # Gemini API key from aistudio.google.com, starts with AIza...
MIDSCENE_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MIDSCENE_MODEL_NAME=gemini-2.5-flash
MIDSCENE_MODEL_FAMILY=gemini
